# ── Backend ───────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values. Never commit .env.

# Allowed CORS origin for the Vite dev server
CORS_ORIGIN=http://localhost:5173

# Backend host and port (Uvicorn)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# In-memory session TTL in seconds (default: 15 minutes)
SESSION_TTL_SECONDS=900

# ── Frontend ──────────────────────────────────────────────────────────────────
# (Put this in frontend/.env, not here — Vite only reads frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000/api/v1

